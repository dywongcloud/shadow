target/
.env
.env.local

# Ansible: real inventory/secrets are operator-local, never committed --
# only the .example templates ship in the repo.
ansible/inventory/hosts.ini
ansible/inventory/group_vars/all/vault.yml
ansible/.vault_pass
**/.env.local
**/.env.local.*.bak
**/.env.*.bak
.DS_Store
**/.DS_Store
.gm/*
!.gm/constraints.md
!.gm/disciplines/
.gm/disciplines/*
!.gm/disciplines/default/
!.gm/disciplines/default/**
!.gm/disciplines/rs-learn_router/
!.gm/disciplines/rs-learn_router/**
# codeinsight/codeinsight-manifest/codeinsight-vec (matched by the
# .gm/disciplines/* line above, with no re-include below) are a regenerable
# per-file code-search index+embedding cache (rebuilt automatically on digest
# mismatch, see gm-plugkit's codeinsight_rebuild) -- thousands of tiny derived
# files, never durable discipline content.
.gm/pw-sock-*/
.gm/browser-profile/
.gm/browser-profile-*/

# Agent-tool worktree/session scratch (isolated-worktree subagents, local
# settings) -- transient tooling state, never durable repo content.
.claude/

# agentplug-runner per-repo KV scratch (native spool host runtime state,
# regenerated on daemon boot) -- transient tooling state, never repo content.
.agentplug-kv/
# agentplug-runner single-shot dispatch scratch (used when the shared
# daemon is wedged; pure runtime state, regenerated per dispatch).
.agentplug/
