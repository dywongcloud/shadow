# {{ ansible_managed }}
[Unit]
Description=shadw hive-cloud node ({{ hive_name }}, region {{ hive_region }})
After=network-online.target
Wants=network-online.target

[Service]
Environment=HIVE_CONTAINER_RUNTIME={{ hive_container_runtime }}
Environment=RUST_LOG={{ hive_rust_log }}
Environment=HIVE_DATA={{ hive_data_dir }}
Environment=HOME={{ ansible_env.HOME | default('/root') }}
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:{{ ansible_env.HOME | default('/root') }}/.cargo/bin
Environment=HIVE_PUBLIC_DASHBOARD_URL={{ hive_public_dashboard_url }}
Environment=HIVE_DASHBOARD_URL={{ hive_dashboard_url }}
# Without this the edge never reverse-proxies the dashboard hosts (apex/www)
# to the local hive-ui, so the node 404s a share of round-robin page loads
# while looking perfectly healthy — live-witnessed on 4 of 13 nodes as "a
# third of dashboard loads dead-end". A reprovision must never recreate that.
Environment=HIVE_DASHBOARD_UPSTREAM={{ hive_dashboard_upstream | default('http://127.0.0.1:3002') }}
Environment=HIVE_APPS_DOMAIN={{ hive_apps_domain }}
Environment=HIVE_PLATFORM_DOMAIN={{ hive_platform_domain }}
{% if hive_db_domain %}
# Enables the per-tenant DB gateway (managed Postgres/Redis/Supabase wire +
# REST + Studio) AND makes acme.rs's cert-sync fetch the `*.{db_domain}`
# wildcard bundle. Live-witnessed 2026-08-21: this var was hand-applied to
# only some nodes (no automation set it), so once db_host DNS started
# publishing the full healthy node set instead of one fixed owner IP,
# clients round-robinning onto an unset node got a hard TLS handshake
# rejection (SNI resolve() returns None -> "tlsv1 alert access denied") —
# a real user's managed Supabase URL was unreachable ~1/3 of the time. Never
# let this var drift out of sync across the fleet again.
Environment=HIVE_DB_DOMAIN={{ hive_db_domain }}
{% endif %}
Environment=HIVE_DEPLOY_ZONE={{ hive_deploy_zone }}
Environment=HIVE_CP_LEADER={{ hive_cp_leader }}
Environment=HIVE_CP_OWNER_CHAIN={{ hive_cp_owner_chain }}
Environment=HIVE_GOSSIP_IROH={{ hive_gossip_iroh }}
Environment=HIVE_GOSSIP_SIGN={{ hive_gossip_sign }}
Environment=HIVE_GOSSIP_VERIFY={{ hive_gossip_verify }}
Environment=HIVE_DISCOVERY_N0={{ hive_discovery_n0 }}
# Public mainline-DHT address lookup. Additive and last in the provider list:
# bootstrap seeds and the Seer pkarr resolver stay registered and still win on
# latency. Blocked UDP / unresolvable bootstrap => the provider is skipped with
# a WARN and every existing path is unchanged (never a failed bind).
# HIVE_DHT_PUBLISH_DIRECT=1 puts this node's PUBLIC ip:HIVE_IROH_PORT on the
# public DHT alongside its relay URL; 0 publishes the relay URL only. See
# group_vars/all/vars.yml for the full "what becomes publicly resolvable" note.
Environment=HIVE_DISCOVERY_DHT={{ hive_discovery_dht | default('1') }}
{% if hive_dht_port %}
Environment=HIVE_DHT_PORT={{ hive_dht_port }}
{% endif %}
Environment=HIVE_DHT_PUBLISH_DIRECT={{ hive_dht_publish_direct | default('0') }}
# Must exceed the DHT's measured 2.0-4.6s resolve or dial_fresh cancels the
# lookup before it can answer and the DHT provider is inert.
Environment=HIVE_P2P_DISCOVERY_MS={{ hive_p2p_discovery_ms | default('8000') }}
{% if hive_discovery_dns %}
Environment=HIVE_DISCOVERY_DNS={{ hive_discovery_dns }}
{% endif %}
{% if hive_relay_urls %}
Environment=HIVE_RELAY_URLS={{ hive_relay_urls }}
{% endif %}
{% if hive_bootstrap_peers %}
Environment=HIVE_BOOTSTRAP_PEERS={{ hive_bootstrap_peers }}
{% endif %}
{% if hive_fc_boot_args is defined %}
Environment="HIVE_FC_BOOT_ARGS={{ hive_fc_boot_args }}"
{% endif %}
{% if hive_geo is defined and hive_geo %}
# Pins lat/lon/city/country so the UI's displayed location doesn't depend on
# ip-api.com's IP-block geolocation guess, which is wrong for some cloud
# ranges (e.g. this host's real city, guessed as a different Bay Area city).
Environment="HIVE_GEO={{ hive_geo }}"
{% endif %}
# Operator-declared roster of node NAMES in this fleet, derived from the
# inventory itself so it cannot drift from the hosts we actually run. It is the
# allowlist for the departed-node guardian reaper: a node/<name>/snapshot key
# whose name is NOT here, and whose entry is older than HIVE_REAP_MIN_AGE_DAYS,
# is a key no peer can ever serve a blob for (the writing node is gone) and is
# retired. Unset => the reaper refuses entirely rather than treating every node
# as departed, so removing this line is safe, not destructive.
Environment=HIVE_NODE_ROSTER={{ groups['platform'] | map('extract', hostvars, 'hive_name') | select('defined') | join(',') }}
# Health probing. The code defaults (2s timeout / 5s interval) are below
# hive-p2p's 5s connect_budget, so any peer needing a fresh dial is cancelled
# before it can connect and flaps unhealthy -- on the leader that removes live
# nodes from client DNS and placement ("not found") and drives the Vercel DNS
# API into 429 rate limiting. See group_vars/all/vars.yml for the measured
# numbers behind these values. Interval must stay > timeout.
Environment=HIVE_HEALTH_TIMEOUT={{ hive_health_timeout | default(10) }}
Environment=HIVE_HEALTH_INTERVAL={{ hive_health_interval | default(15) }}
Environment=HIVE_HEALTH_FAIL_THRESHOLD={{ hive_health_fail_threshold | default(2) }}
Environment=HIVE_OWNER_EMAIL={{ hive_owner_email }}
Environment=HIVE_ADMIN_EMAILS={{ hive_admin_emails | default('') }}
Environment=HIVE_PUBLIC_NODE_TENANTS={{ hive_public_node_tenants | default('thoth-division') }}
Environment=HIVE_JWT_SECRET={{ vault_hive_jwt_secret }}
Environment=HIVE_INTERNAL_TOKEN={{ vault_hive_internal_token }}
{% if vault_stripe_secret_key %}
Environment=STRIPE_SECRET_KEY={{ vault_stripe_secret_key }}
{% endif %}
{% if vault_github_token %}
Environment=GITHUB_TOKEN={{ vault_github_token }}
{% endif %}
{% if vault_github_webhook_secret %}
Environment=GITHUB_WEBHOOK_SECRET={{ vault_github_webhook_secret }}
{% endif %}
{% if vault_github_app_id %}
Environment=GITHUB_APP_ID={{ vault_github_app_id }}
{% endif %}
{% if vault_github_app_private_key %}
Environment=GITHUB_APP_PRIVATE_KEY={{ vault_github_app_private_key }}
{% endif %}
{% if vault_hive_secret_key %}
Environment=HIVE_SECRET_KEY={{ vault_hive_secret_key }}
{% endif %}
ExecStart={{ hive_binary_path }} --region {{ hive_region }} --name {{ hive_name }} --listen {{ hive_listen }} --admin {{ hive_admin }}{% for p in (hive_extra_peers | default([])) %} --peer {{ p }}{% endfor %}

WorkingDirectory={{ hive_src_dir }}
Restart=always
RestartSec=3
LimitNOFILE=1048576
# hive-cloud spawns podman, and rootful podman's conmon inherits the CALLER's
# cgroup — so with the default KillMode=control-group, every `systemctl
# restart hive-node` SIGTERMs every container on the node: managed Postgres/
# Redis/Supabase stacks AND tenant cells all went down with each fleet roll
# (witnessed 2026-08-18: two live Supabase databases 502'd after a roll;
# postgres logged "received smart shutdown request" in the same millisecond
# as the unit stop). KillMode=process signals ONLY the hive-cloud process —
# the dockerd/containerd precedent for exactly this shape — so databases and
# cells outlive a control-plane restart, as they must.
KillMode=process

[Install]
WantedBy=multi-user.target
