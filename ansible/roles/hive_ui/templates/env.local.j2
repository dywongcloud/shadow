# {{ ansible_managed }}
# The dashboard authenticates users via Clerk (NEXT_PUBLIC_* bake in at BUILD
# time) and forwards API calls to the platform admin ingress.
#
# HIVE_ADMIN points at THIS NODE'S OWN admin listener, not the public api host.
# The Next.js rewrite (`/cloud/:path*` -> `${HIVE_ADMIN}/:path*`) runs
# SERVER-SIDE on the node, so the value is resolved by the NODE's resolver and
# traverses the NODE's network path -- both of which made the public hostname a
# liability, not the safety net the old comment claimed ("points at the public
# api host so the node's own admin_ingress leader-forward applies").
#
# That reasoning was wrong: `admin_ingress` runs on EVERY node and forwards
# mutations to the control-plane leader itself (see AGENTS.md "Round-robin reads
# vs leader-forwarded writes"), so localhost gets the IDENTICAL leader-forward
# semantics. Pointing at the public host bought nothing and cost three ways,
# all of which fired together in the 2026-08-01 dashboard outage:
#   1. DNS dependence -- Tencent's internal resolvers (183.60.83.19) served a
#      STALE pre-delegation answer for api.shadw.cloud pointing at Vercel's
#      wildcard (*.shadw.cloud A 216.150.1.1), so the proxy got Vercel's
#      "DEPLOYMENT_NOT_FOUND" 404 for every dashboard API call on those nodes.
#      Public resolvers (8.8.8.8/1.1.1.1/9.9.9.9) were correct the whole time,
#      which is exactly why this was invisible from a laptop.
#   2. Blast radius -- api.shadw.cloud is round-robin across a couple of nodes,
#      so ONE wedged node broke the dashboard for everyone, on every node.
#   3. A public-internet round trip (plus TLS) for what is a localhost call.
#
# COMPLETENESS INVARIANT: this file, as rendered, is the SINGLE, AUTHORITATIVE,
# COMPLETE source of truth for ui/.env.local on every fleet node. The task that
# deploys it (hive_ui/tasks/main.yml) OVERWRITES the target's whole .env.local
# with this render -- it does NOT merge/preserve any pre-existing value the
# file might already hold (the preceding rsync step also excludes .env.local
# from the source tree, so nothing else repopulates it either). That makes the
# overwrite safe BY CONSTRUCTION only as long as EVERY var any ui/ code path
# reads via `process.env.*` is listed here. Adding a new `process.env.*` read
# anywhere in ui/ REQUIRES adding it here too, in the SAME change -- an
# omission here silently WIPES that var, fleet-wide, next time this role runs.
# (See recall("fleet-creds-fix-ansible-ui-clobber-bug").)
HIVE_ADMIN=http://127.0.0.1:8786
HIVE_INTERNAL_TOKEN={{ vault_hive_internal_token }}
HIVE_OWNER_EMAIL={{ hive_owner_email }}
NEXT_PUBLIC_INGRESS={{ hive_ingress }}
NEXT_PUBLIC_DEPLOYMENT_DOMAIN={{ hive_apps_domain }}
# Clerk sign-in / OAuth redirect origins (ui/app/layout.tsx) -- comma-separated,
# full scheme://host, no trailing slash. Keeps the local-dev ports reachable
# (e.g. an SSH-tunneled admin testing against this node) while adding the
# node's REAL public dashboard host(s) -- apex + www, the two SANs the
# platform ACME bundle issues for the self-hosted dashboard (see
# crates/hive-cloud/src/acme.rs::bundles). Deliberately platform_domain only,
# never apps_domain (user-deployment domain; RUNBOOK.md's two-domain
# isolation -- user content must never share Clerk's cookie/redirect origin).
NEXT_PUBLIC_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,https://{{ hive_platform_domain }},https://www.{{ hive_platform_domain }}
{# `is defined` alone is NOT enough: the vault once carried these keys PRESENT
   but EMPTY, so the block rendered blank values and next-server 500'd every
   request on the freshly-provisioned node (fr, 2026-07-31) with Clerk's
   "Missing publishableKey/secretKey". Because this render OVERWRITES the whole
   file (see the completeness invariant above), an empty vault value would also
   WIPE the working keys off every node the role re-runs on. Require non-empty. #}
{% if vault_clerk_publishable_key | default('') | length > 0 %}
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY={{ vault_clerk_publishable_key }}
CLERK_SECRET_KEY={{ vault_clerk_secret_key }}
{% endif %}
{# Same non-empty requirement as the Clerk block above, and for the same reason
   witnessed again on 2026-08-08: the vault carried `vault_composio_api_key`
   PRESENT but EMPTY (`""`), so every node rendered a bare `COMPOSIO_API_KEY=`
   line. `composioConfigured()` is `!!process.env.COMPOSIO_API_KEY`
   (ui/lib/composio.ts), and an empty string is falsy -- so the whole
   integrations catalog and GitHub OAuth reported "not configured" fleet-wide
   while the key LOOKED set to anyone reading the env file or the vault key
   list. `is defined` cannot tell those apart; length can. #}
{% if vault_composio_api_key | default('') | length > 0 %}
COMPOSIO_API_KEY={{ vault_composio_api_key }}
HIVE_GITHUB_AUTH_CONFIG_ID={{ vault_hive_github_auth_config_id }}
{% endif %}
{# GitHub App, OAUTH half (user-to-server): the browser cookie flow. These four
   lines used to live INSIDE the Composio block above, so GitHub App OAuth was
   silently gated on an UNRELATED product's key being non-empty -- the same
   empty-string trap that comment describes, one level up: drop the Composio key
   and the App's own OAuth disappears with it for reasons nothing in the UI would
   explain. They are independent auth paths and are now guarded independently. #}
{% if vault_github_app_client_id | default('') | length > 0 %}
GITHUB_APP_CLIENT_ID={{ vault_github_app_client_id }}
GITHUB_APP_CLIENT_SECRET={{ vault_github_app_client_secret }}
GITHUB_APP_REDIRECT_URI={{ vault_github_app_redirect_uri }}
{% endif %}
{# GitHub App, SERVER-TO-SERVER half (installation auth). The dashboard's own
   code requires BOTH of these -- ui/lib/github-installation.ts's
   `installationAuthConfigured()` is `!!GITHUB_APP_ID && !!GITHUB_APP_PRIVATE_KEY`
   -- but this template never rendered either, so `githubConnectionDetail`
   reported `installationState: "unconfigured"` on every node and the durable
   fallback could not run ANYWHERE (measured live on fc-virginia 2026-08-08).
   That fallback is what answers "still connected" when a browser cookie is
   absent, expired or revoked; without it an expiring user-to-server token
   (8h by default) surfaces as a recurring "Your GitHub authorization is no
   longer valid -- reconnect" that reconnecting cannot durably fix.
   Same key pair the BACKEND already takes (hive_platform's
   hive-node.service.j2), so both halves of the platform speak as the same App.
   Length-guarded, not `is defined`: an empty string is falsy in the JS that
   reads it, which is exactly how this stayed invisible. #}
{% if vault_github_app_id | default('') | length > 0 %}
GITHUB_APP_ID={{ vault_github_app_id }}
{% endif %}
{% if vault_github_app_private_key | default('') | length > 0 %}
GITHUB_APP_PRIVATE_KEY={{ vault_github_app_private_key }}
{% endif %}
{% if vault_github_webhook_secret is defined %}
# Signs the webhook this node's UI installs on a repo (ui/app/api/gitops/
# project-ci/route.ts, .../init/route.ts) -- MUST equal the value the BACKEND
# (hive_platform role) uses to VERIFY incoming deliveries, since the node
# that registers a repo's webhook may not be the node that later receives it.
GITHUB_WEBHOOK_SECRET={{ vault_github_webhook_secret }}
{% endif %}
# Public URL GitHub should POST webhook deliveries to -- the above two routes
# append /v1/git/webhook. Same origin as HIVE_ADMIN (this node's admin
# ingress); defaulting it here (rather than leaving it unset) makes the
# primary real-webhook deploy path work out of the box instead of silently
# falling back to the inferior push-to-main-only Actions-workflow mechanism.
OPENEDGE_WEBHOOK_URL=https://api.{{ hive_platform_domain }}
