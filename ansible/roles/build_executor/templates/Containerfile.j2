# {{ ansible_managed }}
# The toolchain is supplied by the reviewed, digest-pinned base. This file does
# not contact a mutable package repository while building.
FROM {{ build_executor_builder_base_image }}

USER 0:0
RUN set -eu; \
    for path in /bin/sh /bin/sleep /bin/tar /usr/bin/awk /usr/bin/env /usr/bin/find /usr/bin/id /usr/bin/realpath /usr/bin/stat /usr/bin/wc; do test -x "$path"; done; \
    for command in curl id sleep cp dd du cut grep tar git node npm corepack bun python3 go buildah{% if build_executor_rust_enabled | bool %} cargo rustc{% endif %}; do command -v "$command" >/dev/null; done; \
    if grep -Eq '^[^:]*:[^:]*:{{ build_executor_container_uid }}:' /etc/passwd; then \
      grep -Eq '^[^:]*:[^:]*:{{ build_executor_container_uid }}:{{ build_executor_container_gid }}:' /etc/passwd; \
    else \
      printf 'hivebuild:x:{{ build_executor_container_uid }}:{{ build_executor_container_gid }}:Build Executor:/home/hivebuild:/bin/sh\n' >>/etc/passwd; \
    fi; \
    grep -Eq '^[^:]*:[^:]*:{{ build_executor_container_gid }}:' /etc/group || printf 'hivebuild:x:{{ build_executor_container_gid }}:\n' >>/etc/group; \
    mkdir -p /workspace /home/hivebuild/.config/containers; \
    printf '%s\n' '[storage]' 'driver = "vfs"' 'runroot = "/tmp/buildah-run"' 'graphroot = "/workspace/.buildah/storage"' > /home/hivebuild/.config/containers/storage.conf; \
    chown -R {{ build_executor_container_uid }}:{{ build_executor_container_gid }} /workspace /home/hivebuild
{% if build_executor_rust_enabled | bool %}
# Native Rust lane: the reviewed base must ALREADY carry a PINNED toolchain and a seeded offline
# crate set. --network=none makes installing either here impossible, and a floating rustup download
# would break the supply-chain pin. Assert instead of install: a base without them fails the image
# build loudly, and Rust builds stay fail-closed on that node.
RUN set -eu; \
    test -x /opt/hive-rust/bin/cargo; \
    test -x /opt/hive-rust/bin/rustc; \
    test "$(/opt/hive-rust/bin/rustc --version | /usr/bin/awk '{print $2}')" = "{{ build_executor_rust_version }}"; \
    test -d {{ build_executor_rust_vendor_dir }}; \
    test -f {{ build_executor_rust_vendor_dir }}/.hive-vendor-seal; \
    test "$(/usr/bin/awk 'NR==1 {print $1}' {{ build_executor_rust_vendor_dir }}/.hive-vendor-seal)" = "{{ build_executor_rust_vendor_sha256 }}"; \
    test -f {{ build_executor_rust_cargo_home }}/config.toml; \
    /usr/bin/grep -qxF '[net]' {{ build_executor_rust_cargo_home }}/config.toml; \
    /usr/bin/grep -qxF 'offline = true' {{ build_executor_rust_cargo_home }}/config.toml
{% endif %}
LABEL org.hive.build-executor.protocol="{{ build_executor_protocol }}"
ENV HOME=/home/hivebuild
{% if build_executor_rust_enabled | bool %}
# The executor's env -i wrapper sets BASE_PATH itself; this keeps the image's own default PATH
# consistent so the toolchain assertion above (and any operator exec) resolves the same binaries.
ENV PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/opt/hive-rust/bin"
{% endif %}
WORKDIR /workspace
USER {{ build_executor_container_uid }}:{{ build_executor_container_gid }}
ENTRYPOINT []
CMD ["/bin/sh"]
