# {{ ansible_managed }}
# Non-secret configuration for the headless browser node. The ONE credential
# this subsystem needs (HIVE_INTERNAL_TOKEN) is deliberately NOT here: it lives
# in {{ hive_browser_node_token_file }} (root, 0600) and reaches the broker
# through systemd LoadCredential=, so it is absent from this file, from the
# unit files, from `systemctl show`, and from every process environment.

# --- broker ---
HIVE_BROWSER_NODE_PORT={{ hive_browser_node_port }}
HIVE_ADMIN=http://127.0.0.1:{{ hive_admin.split(':')[1] | default('8786') }}
HIVE_BROWSER_NODE_WWW={{ hive_browser_node_root }}/www
HIVE_BROWSER_NODE_NAME={{ hive_name }}
HIVE_BROWSER_NODE_TEAM={{ hive_browser_node_team }}
HIVE_BROWSER_NODE_ROLE={{ hive_browser_node_role }}
HIVE_BROWSER_NODE_SCOPE={{ hive_browser_node_scope }}
HIVE_BROWSER_NODE_SERVE_MODE={{ hive_browser_node_serve_mode }}
HIVE_BROWSER_NODE_DEPLOYMENT={{ hive_browser_node_deployment }}
HIVE_BROWSER_NODE_FUNCTION={{ hive_browser_node_function }}
HIVE_BROWSER_NODE_RELAYS={{ hive_browser_node_relays | trim }}
HIVE_BROWSER_NODE_HEARTBEAT_STALE_MS={{ hive_browser_node_heartbeat_stale_ms }}
HIVE_BROWSER_NODE_BOOT_GRACE_MS={{ hive_browser_node_boot_grace_ms }}
{% if hive_geo is defined and hive_geo %}
# Presence coordinates come from the host's own operator-declared HIVE_GEO
# (inventory), never from a geolocation API and never from the browser's
# Geolocation permission — which does not exist headlessly and would be a lie
# if it did. Format matches hive-node's HIVE_GEO: lat,lon,city,country.
HIVE_BROWSER_NODE_LAT={{ hive_geo.split(',')[0] }}
HIVE_BROWSER_NODE_LON={{ hive_geo.split(',')[1] }}
{% else %}
# {{ inventory_hostname }} declares no `hive_geo`, so no coordinate is written
# here — deliberately, because inventing one is worse than publishing none.
# The broker instead asks the PLATFORM where it thinks this host is (its own
# `is_self` record in GET /v1/nodes) and publishes that, so the browser node
# lands on top of its host node on the constellation. Pin `hive_geo` on this
# host in inventory/hosts.ini to override, exactly as hive-node's own position
# is pinned. Verify which source won: /healthz's `geo_source`
# (declared|registry|none).
{% endif %}

# --- browser supervisor ---
HIVE_BROWSER_NODE_CHROME={{ hive_browser_node_chrome_bin }}
HIVE_BROWSER_NODE_PROFILE={{ hive_browser_node_state_dir }}/profile
HIVE_BROWSER_NODE_JS_HEAP_MB={{ hive_browser_node_js_heap_mb }}
HIVE_BROWSER_NODE_HEALTH_POLL_SECS={{ hive_browser_node_health_poll_secs }}
HIVE_BROWSER_NODE_HEALTH_FAIL_LIMIT={{ hive_browser_node_health_fail_limit }}
