# Copy this file to hosts.ini (gitignored) and fill in real hosts. hosts.ini
# itself is never committed -- only this .example template is, so the repo
# never carries real fleet IPs.
#
# Groups:
#   [platform]  every node that runs hive-cloud (all of fc_kvm + fc_pvm)
#   [fc_kvm]    hosts with REAL hardware /dev/kvm (bare metal, or a cloud VM
#               with nested virtualization) -- Firecracker runs directly,
#               no kernel work needed.
#   [fc_pvm]    hosts WITHOUT hardware KVM (the common case on cloud VMs
#               that don't expose nested virt) -- Firecracker runs via PVM,
#               which needs a custom host + guest kernel build per host.
#
# A host belongs to exactly one of fc_kvm / fc_pvm, and always to platform.

[platform:children]
fc_kvm
fc_pvm

[fc_kvm]
# bare-metal or nested-virt-enabled hosts; ansible_host = real IP.
# hive_public_ip is required for this node to be published to DNS
# (RUNBOOK.md Phase-0 step 4) -- omit it for an internal-only node.
bkk-example ansible_host=203.0.113.10 ansible_user=root hive_name=fc-example1 hive_region=example-region hive_public_ip=203.0.113.10

[fc_pvm]
# cloud VMs without hardware KVM -- see roles/pvm_firecracker/README.md.
# fsgsbase/rdtscp are NOT a requirement for adding a host here: the patch
# series turns both into soft runtime fallbacks, and preflight only logs which
# path a host will use.
#
# pvm_skip=true excludes a host from the pvm_firecracker role ENTIRELY (no
# kernel build, no patching, no REBOOT, no microVM smoke test). Set it in
# inventory rather than relying on a hand-shaped --limit, because this role
# reboots and an exclusion you have to remember is one you will eventually
# forget. Use it for a host that must not be rebooted, one that is down, or one
# with a known-bad PVM kernel (a real case: a host where booting a microVM
# hard-resets the machine).
va-example  ansible_host=203.0.113.20 ansible_user=root hive_name=fc-example2 hive_region=example-region-2 hive_public_ip=203.0.113.20
sj-example  ansible_host=203.0.113.21 ansible_user=root hive_name=fc-example3 hive_region=example-region-2 hive_public_ip=203.0.113.21
# fr-example  ansible_host=203.0.113.22 ansible_user=root hive_name=fc-example4 hive_region=example-region-3 hive_public_ip=203.0.113.22 pvm_skip=true

[platform:vars]
ansible_python_interpreter=/usr/bin/python3
# The control-plane owner chain (comma-separated hive_name values, most-
# preferred first). See crates/hive-cloud/src/cluster.rs::control_plane_owner.
hive_cp_owner_chain=fc-example1,fc-example2,fc-example3

# Hosts running ONE headless browser node each (ansible/playbooks/browser-nodes.yml,
# roles/hive_browser_node). A browser node is the /run-node page's worker --
# crates/hive-browser's wasm BrowserNode over iroh QUIC via a WSS relay --
# running unattended under headless Chromium, capped by systemd so it can never
# compete with the hive-node process on the same box.
#
# Membership is deliberately NARROW and asserted twice (the playbook checks this
# group, the role checks hive_browser_node_allowed in its defaults), because the
# node consumes real memory/CPU on a machine whose actual job is the platform.
# One host per REGION is the intended shape: donor capacity concentrated in one
# region is not capacity, it is a correlated failure.
[browser_nodes]
va-example
sj-example
