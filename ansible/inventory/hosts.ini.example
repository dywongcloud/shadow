# Copy this file to hosts.ini (gitignored: the repo never carries real fleet IPs) and fill in real hosts.
# [platform] is every node that runs hive-cloud (all of fc_kvm + fc_pvm; a host is in exactly one of those two).
# [fc_kvm] has REAL hardware /dev/kvm (bare metal or nested virt): Firecracker runs directly.
# [fc_pvm] has no hardware KVM: Firecracker runs via PVM (custom host + guest kernel build per host).

[platform:children]
fc_kvm
fc_pvm

[fc_kvm]
# hive_public_ip publishes the node to DNS (RUNBOOK.md Phase-0 step 4); omit it for an internal-only node
bkk-example ansible_host=203.0.113.10 ansible_user=root hive_name=fc-example1 hive_region=example-region hive_public_ip=203.0.113.10

[fc_pvm]
# pvm_skip=true on a host line excludes it from the pvm_firecracker role entirely (roles/pvm_firecracker/README.md)
va-example  ansible_host=203.0.113.20 ansible_user=root hive_name=fc-example2 hive_region=example-region-2 hive_public_ip=203.0.113.20
sj-example  ansible_host=203.0.113.21 ansible_user=root hive_name=fc-example3 hive_region=example-region-2 hive_public_ip=203.0.113.21
# fr-example  ansible_host=203.0.113.22 ansible_user=root hive_name=fc-example4 hive_region=example-region-3 hive_public_ip=203.0.113.22 pvm_skip=true

[platform:vars]
ansible_python_interpreter=/usr/bin/python3
# comma-separated hive_name values, most-preferred first (crates/hive-cloud/src/cluster.rs control_plane_owner)
hive_cp_owner_chain=fc-example1,fc-example2,fc-example3

# One headless browser node per host (playbooks/browser-nodes.yml, roles/hive_browser_node); the playbook and the role's hive_browser_node_allowed both assert the membership
[browser_nodes]
va-example
sj-example

# Hosts eligible for the Litebox CellBackend (roles/litebox); litebox_verified=true on a host line records a PASSED `hive-cloud --litebox-probe` on that host
[litebox]
# fr-example
# sj-example   litebox_verified=true
