# hive-cloud node admin API the dashboard proxies to (/cloud/*)
HIVE_ADMIN=http://127.0.0.1:8786

# Composio — enables multi-tenant GitHub OAuth ("Import Git Repository").
# Get a key at https://app.composio.dev. Without it, the dashboard falls back
# to manual git-URL import (which always works).
COMPOSIO_API_KEY=

# Composio auth-config pin — set to a Composio-managed GitHub auth config (or a
# `use_custom_auth` config backed by your own GitHub OAuth app) to force which
# one Composio uses, e.g. one known to grant `read:org` (Composio's managed app
# may not honor a scope override on an existing config). Find/create one on the
# Composio dashboard's Auth Configs page. Optional — unset lets Composio
# auto-pick/create one.
HIVE_GITHUB_AUTH_CONFIG_ID=

# First-party GitHub App OAuth (user-to-server) — the platform's OWN GitHub App,
# used instead of Composio's managed OAuth app when org/private-repo access
# needs it. Get these from your GitHub App's settings page
# (https://github.com/settings/apps/<your-app>). Both ID and secret must be set
# to enable it; without them GitHub linking falls back to Composio (or manual
# git-URL import).
GITHUB_APP_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
GITHUB_APP_CLIENT_SECRET=

# The callback URL registered on the GitHub App (same settings page, under
# "Identifying and authorizing users"). Defaults to the production callback
# below if unset — only needed to override it (e.g. for local dev).
GITHUB_APP_REDIRECT_URI=https://shadw.cloud/oauth/github/callback

# Signs the repo webhook installed after a Git import, so the node's
# /v1/git/webhook can verify incoming payloads. Set to the same value as the
# GitHub App's "Webhook secret" field (any random string) — from the App's
# settings page. Without it, installed webhooks are unsigned.
GITHUB_WEBHOOK_SECRET=

# GitHub App server-to-server auth (app-to-server JWT, RS256) -- the App's OWN
# identity, used by BOTH sides of the platform:
#   * hive-cloud NODE (crates/hive-cloud/src/github_app_auth.rs): mint per-repo
#     installation tokens so a webhook-triggered build can clone private repos
#     with no user session, instead of depending solely on a shared node-wide
#     GITHUB_TOKEN.
#   * THIS DASHBOARD (ui/lib/github-installation.ts): derive the GitHub connect
#     state from GitHub's REAL installation record (GET /app/installations) so
#     a fresh browser without the gh_app_tok cookie no longer wrongly prompts
#     to connect, and let the GitOps writers (config-repo sync, project CI
#     install) mint installation tokens so those writes apply without a
#     per-browser user token. Set it on the hive-ui service as well as the node;
#     without it the dashboard falls back to cookie/Composio-only behavior.
# DIFFERENT credential pair from GITHUB_APP_CLIENT_ID/SECRET above (those are
# the OAuth client id/secret for the interactive user-to-server flow).
# Get GITHUB_APP_ID from the App's settings page and GITHUB_APP_PRIVATE_KEY
# from its "Generate a private key" button (PEM). Both optional.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Clerk — login + multi-tenant accounts/orgs. Set both keys to enable hosted
# auth (sign-in, orgs). Without them the dashboard runs in local mode.
# The Clerk org id becomes the tenant for the platform API (see HIVE_JWT_SECRET).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Marketplace integration. The server-only policy endpoint is required for
# Marketplace deployments. It is a non-secret base URL, but is deliberately
# not exposed to browser code that receives the Clerk template JWT.
MARKETPLACE_URL=http://localhost:4010
#
# Public Marketplace base URL for navigation and project-resource requests.
# It defaults to http://localhost:3000 in development and
# https://marketplace.autheo.dev in production when unset.
NEXT_PUBLIC_MARKETPLACE_URL=http://localhost:3000
#
# DevHub obtains a Clerk JWT using the
# `autheo-marketplace-v1` template and sends it server-side only.
# Marketplace must validate issuer, audience, signature, and expiry via Clerk JWKS.
# Local fixture only: the real Clerk issuer and the audience configured on the
# `autheo-marketplace-v1` template. These are required for normal JWKS verification.
MARKETPLACE_FIXTURE_CLERK_ISSUER=https://your-instance.clerk.accounts.dev
MARKETPLACE_FIXTURE_CLERK_AUDIENCE=your-marketplace-audience
# Optional: use a locally running Hive node's registry ID for fixture-valid.
MARKETPLACE_FIXTURE_APPROVED_NODE_ID=node-a

# Callback / redirect origins the app accepts — comma-separated. Lets auth and
# OAuth (sign-in, GitHub link) work from BOTH local dev and the public platform
# host at once. OAuth callback URLs are also derived from incoming proxy headers
# (x-forwarded-host/proto), so a proxied request returns to its public URL.
NEXT_PUBLIC_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,https://shadw.cloud

# Public domain for live deployment URLs. When set, the dashboard links to
# https://<project>.<domain>/ (the real-DNS apps wildcard) so deployments open
# from anywhere; unset = local http://<project>.localhost:8787.
# Deployments are routed by subdomain, so both work seamlessly.
NEXT_PUBLIC_DEPLOYMENT_DOMAIN=shadw.app

# EXPERIMENT: anonymous team/role membership for protected previews. Requires the
# node to run with `--features zkauth`. When "1", the dashboard auto-enrolls each
# member's ZK key and mints an anonymous proof when opening a preview (no identity
# token sent to the serving node). Off by default — nothing changes when unset.
# NEXT_PUBLIC_ZKAUTH=1

# hive-cloud JWT — when set on the node, admin mutations require a Bearer token
# (mint via POST /v1/token). Unset = local/dev open mode.
HIVE_JWT_SECRET=

# THEO/USD market reference. The default is the Base/Hydrex pair; this public
# value changes only the display-only reference, never a settlement amount.
THEO_MARKET_PAIR_ADDRESS=0x182be47742b81777055d69c50e5c9d2fe803e938

# Wallet-only THEO settlement. Configure these on the hive-cloud node as well:
# no private key, seed phrase, or wallet credential is ever stored here.
THEO_CHAIN_ID=
THEO_CHAIN_NAME=Autheo
THEO_RPC_URL=
THEO_EXPLORER_URL=
THEO_TOKEN_ADDRESS=
THEO_TREASURY_ADDRESS=
# Canonical ERC-20 metadata and settlement finality policy. These must match
# the configured token contract and the chain's operational requirements.
THEO_TOKEN_DECIMALS=
THEO_REQUIRED_CONFIRMATIONS=

# MarketplaceAtomicFeeSplit V2 settlement (configure on hive-cloud, never in
# browser-exposed NEXT_PUBLIC_* variables). The former AtomicSplit profile is
# historical verification only and cannot create a new payment intent.
HIVE_MARKETPLACE_SETTLEMENT_PROFILE=autheo-testnet-v1
HIVE_MARKETPLACE_TESTNET_THEO_TOKEN=0x...
HIVE_MARKETPLACE_TESTNET_ATOMIC_SPLIT_CONTRACT=0x...
HIVE_MARKETPLACE_TESTNET_FEE_RECIPIENT=0x...
HIVE_MARKETPLACE_TESTNET_ATOMIC_SPLIT_AUDITED=1
HIVE_MARKETPLACE_TESTNET_CONFIGURATION_REFERENCE=<approved-v2-configuration-reference>
