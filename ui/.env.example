# hive-cloud node admin API the dashboard proxies to (/cloud/*)
HIVE_ADMIN=http://127.0.0.1:8786

# Composio — enables multi-tenant GitHub OAuth ("Import Git Repository").
# Get a key at https://app.composio.dev. Without it, the dashboard falls back
# to manual git-URL import (which always works).
COMPOSIO_API_KEY=

# Clerk — login + multi-tenant accounts/orgs. Set both keys to enable hosted
# auth (sign-in, orgs). Without them the dashboard runs in local mode.
# The Clerk org id becomes the tenant for the platform API (see HIVE_JWT_SECRET).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Callback / redirect origins the app accepts — comma-separated. Lets auth and
# OAuth (sign-in, GitHub link) work from BOTH local dev and the public platform
# host at once. OAuth callback URLs are also derived from incoming proxy headers
# (x-forwarded-host/proto), so a proxied request returns to its public URL.
NEXT_PUBLIC_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,https://shadw.cloud

# Public domain for live deployment URLs. When set, the dashboard links to
# https://<project>.<domain>/ (the real-DNS apps wildcard) so deployments open
# from anywhere; unset = local http://<project>.localhost:8787.
# Deployments are routed by subdomain, so both work seamlessly.
NEXT_PUBLIC_DEPLOYMENT_DOMAIN=shadw.app

# EXPERIMENT: anonymous team/role membership for protected previews. Requires the
# node to run with `--features zkauth`. When "1", the dashboard auto-enrolls each
# member's ZK key and mints an anonymous proof when opening a preview (no identity
# token sent to the serving node). Off by default — nothing changes when unset.
# NEXT_PUBLIC_ZKAUTH=1

# hive-cloud JWT — when set on the node, admin mutations require a Bearer token
# (mint via POST /v1/token). Unset = local/dev open mode.
HIVE_JWT_SECRET=

# Stripe — real billing (Pro/Enterprise plan checkout + compute-credit top-ups).
# The actual STRIPE_SECRET_KEY/STRIPE_WEBHOOK_SECRET live on the hive-cloud NODE
# (checkout is server-to-server via the Rust backend, not client-side Stripe.js),
# not here — see crates/hive-cloud/src/billing.rs. The dashboard's own checkout
# flow redirects to Stripe's HOSTED Checkout page, so it does not need the
# publishable key today; it's included for a future embedded/Elements flow.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
