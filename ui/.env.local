# Dashboard admin/API source. Stage 3 cutover: the dashboard's same-origin /cloud
# proxy now targets the fleet's authenticated nearest-region ingress (api.shadw.cloud
# -> regional AdminAPI -> leader), NOT node-a loopback. REVERT (emergency fallback):
# set HIVE_ADMIN=http://127.0.0.1:8786 and restart the :3002 server.
HIVE_ADMIN=https://api.shadw.cloud
# Ops/admin console API host (the /admin pages proxy here via /ops).
HIVE_ADMIN_OPS=https://api.shadw.cloud
# Owner identity for the /api/token mint (tenant="personal" for these accounts;
# mirrors the backend HIVE_OWNER_EMAIL). Comma-separated.
HIVE_OWNER_EMAIL=dylanwong007@gmail.com
# Internal mint authorization presented by /api/token to the backend /v1/token
# (fails closed on the fleet without it). Must match the fleet's HIVE_INTERNAL_TOKEN.
HIVE_INTERNAL_TOKEN=d715cc061c1092f8e40f7059eaea7906d63dd2a795ca1d4b2f59fcadb454a4f6
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_bWFueS1iZWFnbGUtNjcuY2xlcmsuYWNjb3VudHMuZGV2JA
CLERK_SECRET_KEY=sk_test_kLdrzZ0dmPqqjl8YQMT9CT9tZsCngwYr0yQpv1cZSO
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

COMPOSIO_API_KEY=ak_mjkZBu5MW344-qxwgaro

OPENEDGE_WEBHOOK_URL=https://openedge.ngrok.pizza

# Live deployment URLs served via the gateway's ngrok wildcard tunnel (see ngrok.yml).
# Unset this to revert dashboard links to http://<project>.localhost:8787.
NEXT_PUBLIC_INGRESS=dns
NEXT_PUBLIC_DEPLOYMENT_DOMAIN=shadw.app
