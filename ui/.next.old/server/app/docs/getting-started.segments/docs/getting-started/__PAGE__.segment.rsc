PI"}]," at ",["$","code",null,{"className":"rounded bg-subtle px-1.5 py-0.5 font-mono text-[0.85em] text-fg","children":"https://api.shadw.cloud"}],". (Self-hosting? The same endpoints live on your node's admin API — default ",["$","code",null,{"className":"rounded bg-subtle px-1.5 py-0.5 font-mono text-[0.85em] text-fg","children":"127.0.0.1:8786"}],".)"]}]]}]]}],["$","section",null,{"id":"quickstart","className":"scroll-mt-20 border-t border-border pt-12 first:border-0 first:pt-0","children":[["$","div",null,{"className":"mb-2 font-mono text-xs uppercase tracking-widest text-link","children":"Get started"}],["$","h2",null,{"className":"text-2xl font-semibold tracking-tight sm:text-3xl","children":"Quickstart"}],["$","div",null,{"className":"mt-5 space-y-4 text-[15px] leading-relaxed text-secondary","children":[["$","p",null,{"children":["From the dashboard, click ",["$","strong",null,{"className":"text-fg","children":"New Project"}],", pick a template or paste a Git URL, and deploy. Or via the API:"]}],["$","$L2",null,{"tabs":[{"label":"deploy.sh","code":"curl -X POST https://api.shadw.cloud/v1/git/deploy \\\n  -H 'content-type: application/json' -H 'x-hive-team: personal' \\\n  -d '{ \"repo_url\": \"https://github.com/acme/app\", \"project\": \"my-app\", \"production\": true }'\n# -> { \"build_id\": \"dpl-…\", \"project\": \"my-app\" }","lang":"bash","filename":"deploy.sh"}]}],["$","p",null,{"children":["Your deployment is reachable instantly at its deployment URL (a self-refreshing ",["$","em",null,{"children":"Building…"}]," page shows until the build finishes)."]}]]}]]}],["$","section",null,{"id":"deploying","className":"scroll-mt-20 border-t border-border pt-12 first:border-0 first:pt-0","children":[["$","div",null,{"className":"mb-2 font-mono text-xs uppercase tracking-widest text-link","children":"Builds"}],["$","h2",null,{"className":"text-2xl font-semibold tracking-tight sm:text-3xl","children":"Deploying apps"}],["$","div",null,{"className":"mt-5 space-y