a:["$","p",null,{"className":"mt-6 text-[15px] leading-relaxed text-secondary","children":"Interact programmatically with your shadw cloud using direct HTTP requests. You can create deployments, manage custom domains and DNS, configure projects, and wire up webhooks — all over the mesh."}]
