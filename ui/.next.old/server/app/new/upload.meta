{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/new/layout,_N_T_/new/upload/layout,_N_T_/new/upload/page,_N_T_/new/upload"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/new/upload/__PAGE__",
    "/new/upload",
    "/new",
    "/_index",
    "/_head"
  ]
}