{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/storage/layout,_N_T_/storage/page,_N_T_/storage"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/storage/__PAGE__",
    "/storage",
    "/_index",
    "/_head"
  ]
}