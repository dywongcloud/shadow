{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/cdn/layout,_N_T_/cdn/redirects/layout,_N_T_/cdn/redirects/page,_N_T_/cdn/redirects"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/cdn/redirects/__PAGE__",
    "/cdn/redirects",
    "/cdn",
    "/_index",
    "/_head"
  ]
}