{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/cdn/layout,_N_T_/cdn/caches/layout,_N_T_/cdn/caches/page,_N_T_/cdn/caches"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/cdn/caches/__PAGE__",
    "/cdn/caches",
    "/cdn",
    "/_index",
    "/_head"
  ]
}