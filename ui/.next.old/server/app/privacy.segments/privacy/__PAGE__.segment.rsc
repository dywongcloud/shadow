0:{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"children":[["$","$L3",null,{"eyebrow":"Legal","title":["Privacy ",["$","span",null,{"className":"bg-gradient-to-r from-fuchsia-400 via-cyan-300 to-blue-500 bg-clip-text text-transparent","children":"Policy"}]],"subtitle":"Your cloud, your data. Last updated June 2026."}],["$","$L4",null,{"className":"pb-24","children":["$","div",null,{"className":"mx-auto max-w-3xl space-y-8","children":[["$","div","Overview",{"children":[["$","h2",null,{"className":"text-xl font-semibold text-white","children":"Overview"}],["$","p",null,{"className":"mt-2 leading-relaxed text-zinc-400","children":"shadw is a self-hosted, peer-to-peer cloud. When you self-host, your application data, deployments, and durable storage live on nodes you operate — not ours. This policy describes what the hosted dashboard and managed services collect."}]]}],["$","div","Data we collect",{"children":[["$","h2",null,{"className":"text-xl font-semibold text-white","children":"Data we collect"}],["$","p",null,{"className":"mt-2 leading-relaxed text-zinc-400","children":"Account details (name, email, organization) for authentication; project and deployment metadata to run the dashboard; and aggregate, non-identifying usage metrics to improve the product. Environment variables and secrets are encrypted at rest and never logged in plaintext."}]]}],["$","div","Your application data",{"children":[["$","h2",null,{"className":"text-xl font-semibold text-white","children":"Your application data"}],["$","p",null,{"className":"mt-2 leading-relaxed text-zinc-400","children":"Deployments, databases (GuardianDB), and durable data are stored on the nodes in your mesh. On a self-hosted cluster, that data never leaves your infrastructure. We do not read, sell, or share your application data."}]]}],["$","div","DNS & domains",{"children":[["$","h2",null,{"className":"text-xl font-semibold text-white","children":"DNS & domains"}],["$","p",null,{"className":"mt-2 leading-relaxed text-zinc-400","children":"When you bring a domain into the DNS console, we store the records you configure to answer DNS queries and to attach domains to deployments. You can export or delete these records at any time."}]]}],["$","div","Cookies & sessions",{"children":[["$","h2",null,{"className":"text-xl font-semibold text-white","children":"Cookies & sessions"}],["$","p",null,{"className":"mt-2 leading-relaxed text-zinc-400","children":"We use first-party cookies strictly to keep you signed in and to remember your active team. No third-party advertising trackers."}]]}],["$","div","Data retention & deletion",{"children":[["$","h2",null,{"className":"text-xl font-semibold text-white","children":"Data retention & deletion"}],["$","p",null,{"className":"mt-2 leading-relaxed text-zinc-400","children":"You can delete projects, deployments, domains, and your account at any time from the dashboard. Deleting a resource removes its metadata from our systems; self-hosted data is removed when you remove it from your nodes."}]]}],["$","div","Contact",{"children":[["$","h2",null,{"className":"text-xl font-semibold text-white","children":"Contact"}],["$","p",null,{"className":"mt-2 leading-relaxed text-zinc-400","children":"Questions about privacy or a data request? Email privacy@shadw.cloud and we'll respond promptly."}]]}]]}]}]]}],[["$","script","script-0",{"src":"/_next/static/chunks/3klah9u6td24u.js","async":true}]],["$","$L5",null,{"children":["$","$6",null,{"name":"Next.MetadataOutlet","children":"$@7"}]}]]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"I09ltZQnHF8RehZidsjPQ"}
