{
  "name": "@openedge/vercel-sdk",
  "version": "0.1.0",
  "description": "Fork of @vercel/sdk repointed at the OpenEdge platform API and authenticated with OpenEdge platform keys (hive_). Adds an integrations namespace for Composio-linked integration resources.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": ["vercel", "sdk", "openedge", "integrations", "composio"],
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
